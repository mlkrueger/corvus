# Corvus configuration. Every variable is optional: with none set, Corvus uses ~/.corvus/corvus.db.
# Copy to ~/.config/corvus/env (chmod 600) or export in your shell. Placeholder values only — never commit secrets.
# Reference: spec/system/10-config-ops.md

# CORVUS_STATE_DIR=/home/you/.corvus
# CORVUS_DATABASE_URL=sqlite:///home/you/.corvus/corvus.db

# Enables the HTTP API (`corvus serve`). At least 32 characters. Generate one with: openssl rand -hex 32
# CORVUS_API_TOKEN=replace-with-output-of-openssl-rand-hex-32
# CORVUS_HTTP_PORT=8765

# CORVUS_LEASE_SECONDS=900
# CORVUS_ACTIVE_SECONDS=120
# CORVUS_IDLE_SECONDS=900
# CORVUS_AUTO_END_SECONDS=3600
# CORVUS_OPERATOR_NAME=operator
# CORVUS_EXPORT_REPO=/absolute/path/to/a/git/work/tree
# CORVUS_AGENT_NAME=my-agent
# CORVUS_HOOK_THROTTLE_SECONDS=5
# CORVUS_ENV_FILE=/home/you/.config/corvus/env
# CORVUS_LOG=info

# Jira source: enabled only when all three of BASE_URL, EMAIL and API_TOKEN are set.
# CORVUS_JIRA_BASE_URL=https://your-site.atlassian.net
# CORVUS_JIRA_EMAIL=you@example.com
# CORVUS_JIRA_API_TOKEN=replace-me
# CORVUS_JIRA_POLL_SECONDS=60
# CORVUS_JIRA_POOL=default
# CORVUS_JIRA_IGNORE_ACCOUNTS=

# Linear source: enabled when the API key is set.
# CORVUS_LINEAR_API_KEY=replace-me
# CORVUS_LINEAR_POLL_SECONDS=60
# CORVUS_LINEAR_POOL=default
# CORVUS_LINEAR_IGNORE_USERS=
